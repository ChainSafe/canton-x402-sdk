version: "1.0"
scope: "canton-x402-sdk — exact-canton wire packages (@chainsafe/x402-*)"
inherits: "../.invariants"
since: "2026-08-02"
authority: "SDK maintainers — not agent-writable"

asserts:

  - id: exact_canton_scheme_id
    claim: "TODO(owners): scheme id exact-canton is defined and exported here."
