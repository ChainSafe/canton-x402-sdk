# Canton x402 SDK Configuration
# Copy to .env and fill in values

# === Localnet (cn-quickstart) ===
# No auth config needed -- uses shared-secret HS256 JWT with secret="unsafe"
# CANTON_LEDGER_URL=http://localhost:2975
# CANTON_SCAN_PROXY_URL=http://scan.localhost:4000
# CANTON_NETWORK=canton-local

# === DevNet ===
# CANTON_OAUTH_TOKEN_URL=https://dev-2j3m40ajwym1zzaq.eu.auth0.com/oauth/token
# CANTON_OAUTH_CLIENT_ID=your-client-id
# CANTON_OAUTH_CLIENT_SECRET=your-client-secret
# CANTON_LEDGER_URL=https://canton-ledger-api-http-dev1.01.chainsafe.dev/api/json-api
# CANTON_SCAN_PROXY_URL=https://wallet-validator-dev1.01.chainsafe.dev/api/validator/v0/scan-proxy
# CANTON_NETWORK=canton-devnet

# Party IDs (discovered via setup script or wallet UI)
# PAYER_PARTY=
# PAYEE_PARTY=

# DSO Party (global domain admin)
# CANTON_DSO_PARTY=DSO::1220...
