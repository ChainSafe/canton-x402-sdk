# Dependencies
node_modules/

# Build output
dist/
# Exception: package dist IS committed — it's shipped for git-dependency installs
# (consumers fetch the prebuilt package over git; there is no build-on-install).
!packages/*/dist/
!packages/*/dist/**
# but not the sourcemaps — bloat, and useless in a prebuilt shipped dep
packages/*/dist/*.map
coverage/
*.tsbuildinfo

# Environment (contains party IDs, secrets, OAuth credentials)
.env
.env.local
.env.*.local
examples/**/.env

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Claude
.claude/

# Canton key files (never commit)
*-key.json
*.key.json
