{
  "name": "@chainsafe/x402-express",
  "version": "0.1.0",
  "description": "Express middleware for x402 payments on Canton — gate a route behind a Canton Coin payment, verified (and optionally settled) via a facilitator.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainSafe/canton-x402-sdk.git",
    "directory": "packages/x402-express"
  },
  "homepage": "https://github.com/ChainSafe/canton-x402-sdk/tree/main/packages/x402-express#readme",
  "bugs": "https://github.com/ChainSafe/canton-x402-sdk/issues",
  "keywords": [
    "x402",
    "canton",
    "payments",
    "express",
    "middleware"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@chainsafe/x402-core": "workspace:^",
    "@chainsafe/x402-client": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "express": "^5.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "prepack": "tsup",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
