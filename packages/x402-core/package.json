{
  "name": "@chainsafe/x402-core",
  "version": "0.1.0",
  "description": "Shared x402 Canton wire types, canonical requirements hashing, verify primitives, and network presets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainSafe/canton-x402-sdk.git",
    "directory": "packages/x402-core"
  },
  "homepage": "https://github.com/ChainSafe/canton-x402-sdk/tree/main/packages/x402-core#readme",
  "bugs": "https://github.com/ChainSafe/canton-x402-sdk/issues",
  "keywords": [
    "x402",
    "canton",
    "payments",
    "web3",
    "micropayments"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "devDependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.2.0",
    "protobufjs": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "valibot": "^1.0.0"
  },
  "scripts": {
    "prepack": "tsup",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
