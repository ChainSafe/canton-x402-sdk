{
  "name": "@chainsafe/x402-core",
  "version": "0.0.1",
  "description": "Shared x402 Canton wire types, canonical requirements hashing, verify primitives, and network presets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
