{
  "name": "@chainsafe/x402-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "x402 SDK — monorepo for the @chainsafe/x402-* packages.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage && node scripts/coverage-report.mjs",
    "docs:api": "typedoc",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "human-id": "^3.0.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.13.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.6"
  }
}
