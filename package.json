{
  "name": "canton-x402-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for x402 payments on Canton Network",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./canton": "./dist/canton/index.js",
    "./facilitator": "./dist/facilitator/index.js",
    "./middleware": "./dist/middleware/index.js",
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jose": "^5.2.0"
  },
  "optionalDependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0"
}
