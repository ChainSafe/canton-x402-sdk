# Gateway — Google OAuth + WebAuthn (see docs/DEPLOY-GCP.md)
GATEWAY_PORT=8790
PUBLIC_ORIGIN=http://localhost:5180
MERCHANT_URL=http://127.0.0.1:8787

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_SECRET=generate-a-long-random-string

# WebAuthn (rpId must match the host users open in the browser)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5180
WEBAUTHN_RP_NAME=ChainSafe one-job APIs

DAILY_SPEND_CAP_CENTS=500

# Same value on the merchant (api) so prepaid jobs can skip per-call 402
GATEWAY_INTERNAL_SECRET=dev-one-job-gateway-secret

# Local only: skip Google when OAuth client is not set yet
ALLOW_DEV_LOGIN=1