# ── Mortgage x402 demo — shared config for all three apps ────────────────────
# Copy to `.env` and fill in. LocalNet is the quickest to run end-to-end; DevNet
# is the real target (the facilitator is a blackbox reached over its URL).

# ── Network ───────────────────────────────────────────────────────────────────
# localnet | devnet | mainnet. Picks the wallet-sdk preset + auth method.
NETWORK=localnet
# Canton network id — canton:mainnet | canton:testnet | canton:devnet |
# canton:localnet. The SDK supplies it for the NETWORK you chose above; set this
# only to override. It must match the `network` the merchant
# advertises in its 402, or `supports()` rejects the offer and no payment is
# attempted. A DevNet reset does NOT change this — the id is a name, not a
# synchronizer fingerprint.
NETWORK_ID=
# DSO party (Amulet asset admin). REQUIRED for localnet; for devnet/mainnet the
# SDK supplies one. This DOES carry the synchronizer fingerprint, so a DevNet
# reset rotates it — set this to the live value after one.
DSO_PARTY=
# Global Synchronizer id, the LOGICAL form `global-domain::1220…`. REQUIRED for
# localnet; for devnet/mainnet the SDK supplies it for the NETWORK above. The
# payer prepares against it and verification pins the signed transaction to it.
SYNCHRONIZER_ID=
# Token Standard registry for Amulet (validator scan-proxy).
AMULET_REGISTRY_URL=
# Price per credit-score pull, in CC. The bureau converts to the atomic units
# the middleware wants.
PRICE_CC=0.05

# ── Credit bureau (x402 merchant) ─────────────────────────────────────────────
# The facilitator that verifies + settles payments (blackbox; DevNet for external users).
FACILITATOR_URL=
# Merchant API key on that facilitator, mapped to BUREAU_PARTY.
FACILITATOR_API_KEY=
# The bureau's Canton party (payment destination; must be an allowed payTo on the facilitator).
BUREAU_PARTY=
BUREAU_PORT=4001

# ── Mortgage backend (x402 payer) ─────────────────────────────────────────────
# Where the backend reaches the bureau. Local dev: http://localhost:4001.
# docker-compose overrides this to http://credit-bureau:4001 automatically.
BUREAU_URL=http://localhost:4001
# Participant JSON Ledger API the payer's wallet-sdk connects to.
# LocalNet default is http://localhost:2975; DevNet/MainNet = your participant.
LEDGER_CLIENT_URL=
# The paying party's key (base64 Ed25519). On LocalNet, onboard + fund a party and
# export these; on DevNet use a funded party's exported key.
PAYER_PARTY_ID=
PAYER_PUBLIC_KEY=
PAYER_PRIVATE_KEY=
# OAuth2 client credentials — DevNet/MainNet only (LocalNet uses unsafe self-signed).
# CANTON_OAUTH_CONFIG_URL is the OIDC provider's discovery/config URL.
CANTON_OAUTH_CONFIG_URL=
CANTON_OAUTH_CLIENT_ID=
CANTON_OAUTH_CLIENT_SECRET=
# Audience/scope for the client-credentials grant. OPTIONAL — defaults to the generic
# Canton audience (https://canton.network.global). If your IdP tenant registers a different
# API identifier, set CANTON_OAUTH_AUDIENCE to it (the value the participant/scan-proxy
# validate `aud` against) — otherwise the token request 403s "Service not enabled within
# domain". CANTON_OAUTH_SCOPE defaults to empty.
CANTON_OAUTH_AUDIENCE=
CANTON_OAUTH_SCOPE=
# Lending policy.
APPROVE_MIN_SCORE=700
MAX_LOAN=2000000
MAX_LTV=0.9
MORTGAGE_BACKEND_PORT=4002

# ── Mortgage UI ────────────────────────────────────────────────────────────────
UI_PORT=5173
# Dev-only: Vite proxies /api → this backend URL (avoids CORS in `pnpm dev`).
VITE_DEV_API=http://localhost:4002
